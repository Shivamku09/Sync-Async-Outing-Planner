# Local-only credentials used by the Docker Compose stack.
POSTGRES_DB=outing_planner
POSTGRES_USER=outing_app
POSTGRES_PASSWORD=local_dev_password
RABBITMQ_USER=outing_app
RABBITMQ_PASSWORD=local_dev_password

# Docker service names are the hosts inside the Compose network.
DATABASE_URL=postgresql+asyncpg://outing_app:local_dev_password@postgres:5432/outing_planner
RABBITMQ_URL=amqp://outing_app:local_dev_password@rabbitmq:5672/
